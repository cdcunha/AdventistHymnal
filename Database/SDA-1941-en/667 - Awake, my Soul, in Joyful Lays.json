{
  "Number": 667,
  "Title": "Awake, my Soul, in Joyful Lays",
  "Author": "Samuel Medley",
  "Copyright": "PublicDomain",
  "CcliNumber": null,
  "Stanzas": [
    {
      "Lines": [
        "Awake, my soul, in joyful lays,",
        "And sing thy great Redeemer’s praise;",
        "He justly claims a song from me;",
        "His lovingkindness, O how free!",
        "Lovingkindness, lovingkindness,",
        "His lovingkindness, O how free!"
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 1
      }
    },
    {
      "Lines": [
        "He saw me ruined in the fall,",
        "Yet loved me notwithstanding all;",
        "He saved me from my lost estate;",
        "His lovingkindness, O how great!",
        "Lovingkindness, lovingkindness,",
        "His lovingkindness, O how great!"
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 2
      }
    },
    {
      "Lines": [
        "Though numerous hosts of mighty foes,",
        "Though earth and hell my way oppose,",
        "He safely leads my soul along:",
        "His lovingkindness, O how strong!",
        "Lovingkindness, lovingkindness,",
        "His lovingkindness, O how strong!"
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 3
      }
    },
    {
      "Lines": [
        "When trouble, like a gloomy cloud,",
        "Has gathered thick and thundered loud,",
        "He near my soul has always stood:",
        "His lovingkindness, O how good!",
        "Lovingkindness, lovingkindness,",
        "His lovingkindness, O how good!"
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 4
      }
    },
    {
      "Lines": [
        "And when earth's rightful King shall come",
        "To take His ransomed people home,",
        "I'll sing upon that blissful shore",
        "His lovingkindness, evermore.",
        "Lovingkindness, lovingkindness,",
        "His lovingkindness, evermore."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 5
      }
    }
  ],
  "StanzaOrder": [
    "Verse 1",
    "Verse 2",
    "Verse 3",
    "Verse 4",
    "Verse 5"
  ]
}