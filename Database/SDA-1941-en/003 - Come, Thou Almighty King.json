{
  "Number": 3,
  "Title": "Come, Thou Almighty King",
  "Author": null,
  "Copyright": "PublicDomain",
  "CcliNumber": null,
  "Stanzas": [
    {
      "Lines": [
        "Come, Thou almighty King,",
        "Help us Thy name to sing,",
        "Help us to praise,",
        "Father all glorious,",
        "O'er all victorious,",
        "Come and reign over us,",
        "Ancient of days."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 1
      }
    },
    {
      "Lines": [
        "Come, holy Comforter,",
        "Thy sacred witness bear",
        "In this glad hour:",
        "Thou who almighty art,",
        "Rule now in every heart,",
        "And ne'er from us depart,",
        "Spirit of power."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 2
      }
    },
    {
      "Lines": [
        "Thou art the mighty One,",
        "On earth Thy will be done",
        "From shore to shore.",
        "Thy sovereign majesty",
        "May we in glory see,",
        "And to eternity",
        "Love and adore."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 3
      }
    }
  ],
  "StanzaOrder": [
    "Verse 1",
    "Verse 2",
    "Verse 3"
  ]
}