{
  "Number": 216,
  "Title": "Holy Spirit, Lamp of Light",
  "Author": null,
  "Copyright": "PublicDomain",
  "CcliNumber": null,
  "Stanzas": [
    {
      "Lines": [
        "Holy Spirit, lamp of light,",
        "Shine upon our nature's night;",
        "Give thy blessed inward sight,",
        "Comforter divine!"
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 1
      }
    },
    {
      "Lines": [
        "We are sinful; cleanse us, Lord;",
        "We are faint; thy strength afford;",
        "Lost — until by thee restored,",
        "Comforter divine!"
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 2
      }
    },
    {
      "Lines": [
        "Like the dew, thy peace distill;",
        "Guide, subdue our wayward will,",
        "Things of Christ unfolding still,",
        "Comforter divine!"
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 3
      }
    },
    {
      "Lines": [
        "In us \"Abba, Father,\" cry —",
        "Earnest of our rest on high,",
        "Hope of immortality,",
        "Comforter divine!"
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 4
      }
    },
    {
      "Lines": [
        "Search for us the depths of God;",
        "Bear us up the starry road",
        "To the height of thine abode,",
        "Comforter divine!"
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 5
      }
    }
  ],
  "StanzaOrder": [
    "Verse 1",
    "Verse 2",
    "Verse 3",
    "Verse 4",
    "Verse 5"
  ]
}