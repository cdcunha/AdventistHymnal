{
  "Number": 659,
  "Title": "I’m But a Stranger Here",
  "Author": "Thomas R. Taylor",
  "Copyright": "PublicDomain",
  "CcliNumber": null,
  "Stanzas": [
    {
      "Lines": [
        "I'm but a stranger here,",
        "Heaven is my home;",
        "Earth is a desert drear,",
        "Heaven is my home;",
        "Danger and sorrow stand",
        "Round me on every hand;",
        "Heaven is my fatherland,",
        "Heaven is my home."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 1
      }
    },
    {
      "Lines": [
        "What though the tempest rage,",
        "Heaven is my home;",
        "Short is my pilgrimage,",
        "Heaven is my home.",
        "Time's cold and wintry blast",
        "Soon will be over past;",
        "I shall reach home at last;",
        "Heaven is my home."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 2
      }
    },
    {
      "Lines": [
        "There at my Saviour's side",
        "Heaven is my home;",
        "I shall be glorified,",
        "Heaven is my home.",
        "There'll be the good and blest,",
        "Those I love most and best,",
        "There too, I too shall rest;",
        "Heaven is my home."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 3
      }
    }
  ],
  "StanzaOrder": [
    "Verse 1",
    "Verse 2",
    "Verse 3"
  ]
}