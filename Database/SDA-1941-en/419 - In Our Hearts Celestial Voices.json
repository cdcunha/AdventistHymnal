{
  "Number": 419,
  "Title": "In Our Hearts Celestial Voices",
  "Author": "Marie Carelli",
  "Copyright": "PublicDomain",
  "CcliNumber": null,
  "Stanzas": [
    {
      "Lines": [
        "In our hearts celestial voices",
        "Softly say:",
        "\"Day is passing, night is coming;",
        "Kneel and pray,\""
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 1
      }
    },
    {
      "Lines": [
        "Father, we obey the summons;",
        "Hear Our cry;",
        "Pity us and help our weakness,",
        "Thou Most High."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 2
      }
    },
    {
      "Lines": [
        "For the joys that most we cherish",
        "Praised be Thou!",
        "Good and gentle art Thou ever;",
        "Hear us now."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 3
      }
    },
    {
      "Lines": [
        "Coming morrows we may never",
        "Live to see;",
        "All we ask Thee is to keep us,",
        "Safe with Thee."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 4
      }
    },
    {
      "Lines": [
        "We are only little children",
        "Kneeling here,",
        "And we want our loving Father",
        "Always near."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 5
      }
    },
    {
      "Lines": [
        "Take us in Thy arms and keep us",
        "As Thine own;",
        "Gather us like little sunbeams",
        "Round Thy throne."
      ],
      "Reference": {
        "Type": "Verse",
        "Number": 6
      }
    }
  ],
  "StanzaOrder": [
    "Verse 1",
    "Verse 2",
    "Verse 3",
    "Verse 4",
    "Verse 5",
    "Verse 6"
  ]
}